# Copy to .env and adjust. Never commit .env.

# ---- ClickHouse ----
CLICKHOUSE_DB=argus
CLICKHOUSE_USER=argus
CLICKHOUSE_PASSWORD=argus
CLICKHOUSE_HTTP_URL=http://localhost:8123

# ---- Postgres ----
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
DATABASE_URL=postgres://argus:argus@localhost:5433/argus

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- MinIO / S3 ----
MINIO_ROOT_USER=argus
MINIO_ROOT_PASSWORD=argus-secret
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=argus-payloads

# ---- Detection service ----
# Consumed by the worker (per-event scans) AND, since the InjectGuard merge
# Phase 2, by the web service (/api/assess/* calls the assessment engine here).
# On Railway set both variables on the worker and the dashboard services.
DETECTION_URL=http://localhost:8000
# Shared secret between the worker and the detection service. Set the SAME value
# on both. Leave empty and the detection API is unauthenticated — it will warn at
# startup and report "auth": false on /health. Anything reachable from outside
# your private network MUST set this.
DETECTION_API_KEY=
# Optional L2 classifier models (Phase 1 ships heuristics; models are pluggable)
DETECTION_ENABLE_L2=false
# Optional L3 judge (any OpenAI-compatible endpoint)
JUDGE_ENDPOINT=
JUDGE_API_KEY=
JUDGE_MODEL=

# ---- Ingestion API ----
INGEST_PORT=3001
# Max ingest requests per project per minute (429 above this). Generous by
# default; lower it if one tenant's retry loop can starve the others.
INGEST_RATE_LIMIT=6000
# Max spans buffered per trace for L4 trace analysis. L4 is O(n^2) in span
# count, so this is a CPU ceiling as much as a memory one.
MAX_BUFFERED_SPANS=500

# ---- Accounts & access ----
# Who may create an account:
#   open        anyone (default — right for local and single-team installs)
#   invite_only only addresses someone already invited (right for hosted)
#   closed      nobody; accounts are created by an admin inviting them
ARGUS_SIGNUP_MODE=open
# The first account ever created becomes the platform operator — a super-admin
# over every tenant. On a deployment reachable from the internet that is a race
# between you and whoever else finds the URL first. Set this to a secret and the
# first signup must present it; until then, no account can be created at all.
ARGUS_BOOTSTRAP_TOKEN=
# Require a verified email before any data can be read (verification is
# otherwise a nudge, not a gate).
REQUIRE_EMAIL_VERIFICATION=0
# Set to 1 only if Argus sits behind a TLS-terminating proxy that does NOT set
# X-Forwarded-Proto — it forces the Secure flag on the session cookie.
ARGUS_FORCE_SECURE_COOKIE=0
# Encrypts stored TOTP secrets (AES-256-GCM) so a database compromise that does
# NOT also leak this environment — a stray backup, a read-only injection — is
# useless for generating second factors. Optional: leave it empty and secrets
# are stored as plain base32, which is the safe default because losing or
# rotating this key locks every enrolled user out of their own account.
# Turning it on later is a no-op for existing enrolments (both formats coexist).
ARGUS_MFA_KEY=

# ---- Data retention ----
# Default retention for new projects, in days. Per-project overrides live in
# the projects table and are editable from Settings.
ARGUS_DEFAULT_RETENTION_DAYS=30

# ---- Operability ----
# Prometheus scrape targets: /metrics on web, ingest, and the worker.
WORKER_HEALTH_PORT=3003
# Pending entries above which the worker reports /health as degraded (503).
WORKER_STALL_PENDING=10000
# Redeliveries before an event is treated as poison and dead-lettered.
CONSUMER_MAX_DELIVERIES=5
# How often the retention sweep runs (ms). Set RETENTION_ENABLED=0 to disable.
RETENTION_INTERVAL_MS=3600000
RETENTION_ENABLED=1

# ---- Alerting ----
# Per-project channels are configured in the UI. This is the legacy global
# fallback, used only for projects with no channels of their own.
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=high
# Repeat alerts for the same content+category+severity are suppressed for this
# many seconds, so a poisoned document retrieved on every request pages once.
ALERT_DEDUP_WINDOW_S=900
ALERT_TIMEOUT_MS=5000
# Public URL of the dashboard. Without it, alert links are relative rather than
# pointing at the recipient's own localhost.
PUBLIC_URL=

# ---- Public read API ----
READ_RATE_LIMIT=600

# ---- Gateway (optional inline proxy — apps/gateway) ----
# observe = score and record only; block = refuse high-confidence injections.
# Start in observe, watch what WOULD have been blocked, then switch.
GATEWAY_MODE=observe
# Score (0-100) at or above which a request is refused. See docs/12-gateway.md
# for how this number was measured against the labelled corpus.
GATEWAY_BLOCK_THRESHOLD=75
# Detection gets this long; past it the request proceeds regardless. Slow is
# treated exactly like down.
GATEWAY_LATENCY_BUDGET_MS=300
# open = allow when detection is unavailable (default, and strongly advised).
# closed = refuse. Only choose this if you have decided that trade yourself.
GATEWAY_ON_FAILURE=open
GATEWAY_UPSTREAM=https://api.openai.com
GATEWAY_PORT=3004
