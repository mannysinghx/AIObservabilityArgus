{
  "manifest_version": 3,
  "name": "Argus Browser Guard",
  "version": "0.4.0",
  "description": "Real-time, local prompt-injection, secret & PII risk detection for ChatGPT, Claude, Gemini, Copilot, and other AI chat apps.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chat.mistral.ai/*",
    "https://chat.deepseek.com/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://poe.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://huggingface.co/chat/*",
    "https://chat.groq.com/*",
    "https://you.com/*",
    "https://coral.cohere.com/*",
    "https://pi.ai/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_popup": "src/popup.html", "default_title": "Argus Browser Guard" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://chat.deepseek.com/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://poe.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://huggingface.co/chat/*",
        "https://chat.groq.com/*",
        "https://you.com/*",
        "https://coral.cohere.com/*",
        "https://pi.ai/*"
      ],
      "js": ["src/scanner-core.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/page-hook.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://chat.deepseek.com/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://poe.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://huggingface.co/*",
        "https://chat.groq.com/*",
        "https://you.com/*",
        "https://coral.cohere.com/*",
        "https://pi.ai/*"
      ]
    }
  ]
}
